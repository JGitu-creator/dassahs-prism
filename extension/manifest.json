{
  "manifest_version": 3,
  "name": "Dassah's Prism: Neural Bridge",
  "version": "1.6.0",
  "description": "Refract selected or explicitly captured page content into clear, actionable focus.",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "notifications"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Dassah's Prism",
    "default_icon": {
      "16": "logo.png",
      "48": "logo.png",
      "128": "logo.png"
    }
  },
  "icons": {
    "16": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
