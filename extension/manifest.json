{
  "manifest_version": 3,
  "name": "Dassah's Prism Engine: Smart Bridge",
  "version": "2.0.0",
  "description": "Smartly routes Excel/code/errors to Prism Forge, Canvas/Classroom courses to Prism Play, Scripture to Prism Word, and dense articles to Prism Focus.",
  "permissions": ["activeTab", "scripting", "contextMenus", "notifications"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Dassah's Prism Engine",
    "default_icon": {
      "16": "logo.png",
      "48": "logo.png",
      "128": "logo.png"
    }
  },
  "icons": {
    "16": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "host_permissions": [
    "https://dassahs-prism.vercel.app/*",
    "http://localhost:3000/*"
  ]
}
