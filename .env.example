# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://kuhbflsmgrlrwkooerpd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI providers
# Server-side only. Add these exact names in Vercel Project Settings for Preview/Production.
# Never expose them as NEXT_PUBLIC_* or commit real secret values.
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b
# Infinite-Tier Orchestrator (Groq -> Gemini 3.5 Flash-Lite -> OpenRouter Free Pool -> Mistral Experiment -> Local Refraction)
# Enabled ON by default; set PRISM_FOUR_TIER_ENABLED=false as an emergency kill-switch.
PRISM_FOUR_TIER_ENABLED=true
# Optional primary provider override: auto | openrouter | gemini | mistral | groq
PRISM_PRIMARY_PROVIDER=auto
GROQ_TIER1_MODEL=openai/gpt-oss-20b
GROQ_TIER2_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=your_gemini_api_key
GEMINI_TIER3_MODEL=gemini-3.5-flash-lite
MISTRAL_API_KEY=your_mistral_api_key
MISTRAL_MODEL=mistral-small-latest
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_FREE_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,baidu/ernie-5.5-flash-preview:free,nvidia/nemotron-3.5-super-vl:free,google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3.5-lightning:free
# Choose one Business regional origin: https://us.openrouter.ai or https://eu.openrouter.ai
# Leave unset to use the global endpoint during development only.
OPENROUTER_BASE_URL=https://us.openrouter.ai
OPENROUTER_MODEL=openrouter/free
# Backward-compatible alias for deployments that already use the router connector.
ROUTER_API_KEY=your_openrouter_api_key
XAI_API_KEY=your_xai_api_key
NEXT_PUBLIC_SITE_URL=https://dassahs-prism.vercel.app

# Lemon Squeezy (payments)
NEXT_PUBLIC_LEMON_SQUEEZY_CHECKOUT_URL=your_lemon_squeezy_checkout_link
LEMON_SQUEEZY_ARCHITECT_VARIANT_ID=your_architect_variant_id
LEMON_SQUEEZY_SOVEREIGN_VARIANT_ID=your_sovereign_variant_id
LEMON_SQUEEZY_WEBHOOK_SECRET=your_webhook_secret

# Credit config
PRISM_CREDITS_PER_REQUEST=10
PRISM_REQUIRE_AUTH_FOR_AI=true
# Enable only after applying supabase/migrations/001_user_credits.sql and 002_ai_usage_ledger.sql.
PRISM_ENFORCE_USER_CREDITS=false

# Shadow mode: disabled by default; never enable without a test-account allowlist.
PRISM_SHADOW_MODE=false
PRISM_SHADOW_USER_IDS=
PRISM_SHADOW_CANDIDATE_URL=
PRISM_SHADOW_CANDIDATE_TOKEN=
PRISM_SHADOW_SYNTHETIC_TOKEN=
PRISM_SHADOW_FIXTURE_SHA256=
PRISM_SHADOW_MAX_CHARS=12000
PRISM_SHADOW_TIMEOUT_MS=8000
PRISM_SHADOW_MAX_OUTPUT_TOKENS=512
PRISM_SHADOW_MAX_COST_USD=0
